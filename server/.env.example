# Copy to .env for local development:  cp .env.example .env
#
# This file is a TEMPLATE ONLY — never put real secrets here, it is committed.
# .env itself is gitignored and therefore NEVER reaches the server.
#
# In production these are set in the platform dashboard, not in a file:
#   Backend  -> DigitalOcean App Platform -> Settings -> App-Level Environment Variables
#   Frontend -> Vercel -> Project Settings -> Environment Variables
# See DEPLOYMENT.md in the repo root.

# ---- Core ----
NODE_ENV=development
# On DigitalOcean App Platform, PORT is injected automatically (8080). Do not set it there.
PORT=3000

# Required. Startup fails (exit 1) if missing or not a valid URL.
MONGODB_URI=
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# All four are REQUIRED and must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_STAFF_SECRET=
JWT_PARTNER_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_STAFF_EXPIRES=8h
JWT_PARTNER_ACCESS_EXPIRES=15m
JWT_PARTNER_REFRESH_EXPIRES=30d

# ---- Media uploads (optional) ----
# Either CLOUDINARY_URL, or the three fields below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Third-party (optional) ----
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- CORS ----
# Comma-separated. In production this MUST include your Vercel domain,
# e.g. ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Per-IP requests per minute across /api. One owner-dashboard load costs ~25
# (doubled in dev by React StrictMode), so keep plenty of headroom.
# POST /api/auth/refresh is excluded and has its own budget.
RATE_LIMIT_MAX=600

# Base URL used to build table QR deep links. In production set this to the
# public customer app URL, otherwise QR codes point at localhost.
CUSTOMER_APP_URL=http://localhost:5173

# ---- Pricing / delivery economics ----
PLATFORM_COMMISSION_PERCENT=15
DELIVERY_PARTNER_PER_DELIVERY_RATE=30
DELIVERY_PARTNER_MAX_CONCURRENT_ORDERS=1
DELIVERY_OFFER_WINDOW_SECONDS=20
DELIVERY_PARTNER_PER_KM_RATE=5
CART_PLATFORM_FEE=6
CART_TAX_PERCENT=5

# ---- SMS / OTP ----
# 'mock' logs the OTP instead of sending it. Use 'messagecentral' in production.
SMS_PROVIDER=mock
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY=
MESSAGECENTRAL_EMAIL=
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com
